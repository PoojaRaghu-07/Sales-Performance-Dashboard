{
  "name": "Dark Blue Modern Business",
  "dataColors": [
    "#38BDF8",
    "#10B981",
    "#F59E0B",
    "#8B5CF6",
    "#EC4899",
    "#6366F1",
    "#14B8A6",
    "#F43F5E"
  ],
  "background": "#0F172A",
  "foreground": "#F8FAFC",
  "tableAccent": "#38BDF8",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#1E293B" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#334155" } },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#000000" } },
            "position": "Outer",
            "preset": "BottomRight"
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#38BDF8" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "Left"
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#94A3B8" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "cardDataLabel": [
          {
            "color": { "solid": { "color": "#F8FAFC" } },
            "fontSize": 20,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "background": [
          {
            "color": { "solid": { "color": "#1E293B" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#38BDF8" } },
            "radius": 8
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": { "solid": { "color": "#38BDF8" } },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#F8FAFC" } },
            "background": { "solid": { "color": "#0F172A" } },
            "fontSize": 10
          }
        ]
      }
    }
  }
}
